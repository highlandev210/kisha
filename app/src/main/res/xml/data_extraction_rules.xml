<?xml version="1.0" encoding="utf-8"?>
<!-- DT-1/NF-8: nothing goes to cloud backup. Device-to-device transfer (the user moving to a new
     phone of their own) is left on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
