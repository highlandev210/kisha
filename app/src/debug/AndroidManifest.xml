<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Compose UI tests host their content in this activity (from ui-test-manifest). Pin it to
             portrait so tests don't depend on how the test phone happens to be lying. Kisha's own
             MainActivity still follows the device's rotation. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            tools:node="merge" />
    </application>
</manifest>
